/* pages/profile/profile.ttss - TikTok Profile 设计还原 */

.page {
  min-height: 100vh;
  background: #000000;
}

/* ===== 顶部导航栏 ===== */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #000000;
}

.top-row {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.top-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.top-username {
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
}

.top-arrow {
  color: #FFFFFF;
  font-size: 28rpx;
}

.menu-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.menu-dot {
  width: 8rpx;
  height: 8rpx;
  background: #FFFFFF;
  border-radius: 50%;
}

/* ===== 头像区域（居中 + 渐变外圈） ===== */
.avatar-section {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 20rpx;
}

.avatar-ring {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  padding: 5rpx;
  background: linear-gradient(135deg, #FE2C55 0%, #FF6B9D 50%, #25F4EE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar {
  width: 182rpx;
  height: 182rpx;
  border-radius: 50%;
  background: #1C1C1E;
  border: 4rpx solid #000000;
}

/* ===== 昵称 + @username ===== */
.nickname {
  display: block;
  text-align: center;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 16rpx;
}

.username {
  display: block;
  text-align: center;
  color: rgba(255, 255, 255, 0.45);
  font-size: 26rpx;
  margin-top: 6rpx;
}

/* ===== 数据统计（3 列） ===== */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 24rpx 8rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx;
}

.stat-num {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stat-label {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  margin-top: 6rpx;
}

/* ===== 操作按钮 ===== */
.actions-row {
  display: flex;
  gap: 12rpx;
  padding: 24rpx 64rpx 20rpx;
}

.edit-btn {
  flex: 1;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.edit-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.icon-btn {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn-arrow {
  color: #FFFFFF;
  font-size: 36rpx;
}

/* ===== Tab 栏 ===== */
.tab-bar {
  display: flex;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-top: 8rpx;
}

.tab-item {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
}

.tab-icon {
  color: rgba(255, 255, 255, 0.4);
  font-size: 44rpx;
  line-height: 1;
}

.tab-item.active .tab-icon {
  color: #FFFFFF;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 6rpx;
  background: #FFFFFF;
  border-radius: 3rpx;
}

/* ===== 视频网格（2 列，9:16 竖版） ===== */
.video-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  padding: 8rpx 8rpx 0;
}

.grid-cell {
  position: relative;
  width: 100%;
  background: #000000;
  overflow: hidden;
  border-radius: 12rpx;
}

.grid-thumb {
  width: 100%;
  display: block;
}

/* 播放图标覆盖层（左下角） */
.play-overlay {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.8);
}

.play-tri-sm {
  width: 0;
  height: 0;
  border-left: 14rpx solid #FFFFFF;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
}

.play-text {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
}

/* 私密视频锁 */
.lock-badge {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  opacity: 0.7;
}

.lock-emoji {
  font-size: 48rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  color: #8E8E93;
  font-size: 26rpx;
}

.bottom-spacer {
  height: 48rpx;
}
