/* custom-tab-bar/index.ttss - 自定义底部导航栏（无顶部白线） */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #000000;
  /* 彻底去除所有分隔线（顶部线 + tab 之间的线） */
  border-top: none !important;
  border: none !important;
  box-shadow: none !important;
  outline: none !important;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  /* tab 之间无竖向分隔线 */
  border: none !important;
  border-left: none !important;
  border-right: none !important;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1;
}
